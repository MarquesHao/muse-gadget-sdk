# Project V1 overlay for the Waveshare ESP32-S3-Touch-AMOLED-1.75C build.
# Load last, after sdkconfig.defaults, devices/sdkconfig.muse and
# devices/sdkconfig.muse-waveshare-s3-175c.
#
# Live voice calls: a tap on the talk button starts/ends a call with Muse,
# holding it still sends a voice note. The project's three-mode switch
# (components/muse, muse_settings_gadget_mode) gates this at run time:
# Text mode never starts a call and never plays a reply aloud.
CONFIG_MUSE_REALTIME_VOICE=y
#
# Meeting recordings (V1.1): the project partition table keeps every
# upstream partition at its offset and adds a FAT "storage" partition in
# the flash past the OTA slots (this board has 32 MB).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_gadget.csv"
#
# Chinese UI pilot (V1.1 P4): Noto Sans SC 16 px as the caption/label CJK
# fallback (~910 KB of flash per the Kconfig help). Captions with Chinese
# (Muse's replies) render instead of boxes, and the gadget-mode names
# plus the Sound page's main rows are shown in Chinese in this build.
CONFIG_MUSE_CJK_FONT=y
CONFIG_MUSE_CJK_FONT_NOTO=y
# Run-time Chinese/English switch (V1.1 fix2): Chinese translations for the
# state names, captions and settings pages, picked by the Language setting
# (default Chinese in this build).
CONFIG_MUSE_GADGET_ZH=y
#
# Custom device.guide for this build (protocols/DEVICE.md contract,
# assembled into the firmware): tells the owner's Muse what this
# gadget is the first time they meet — the three project modes above,
# how meeting recording works (local WAV files only, nothing uploaded),
# the tap-the-face quick panel and where the volume lives. Kept free of
# anything personal; it is compiled into the firmware for anyone holding
# the device to read.
CONFIG_MUSE_DEVICE_GUIDE="devices/guides/muse-gadget-175c.md"
